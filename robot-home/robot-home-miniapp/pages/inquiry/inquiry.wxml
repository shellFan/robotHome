<view class="page safe-bottom">
  <view class="rh-card" wx:if="{{robotName}}">
    <text class="robot-name">{{robotName}}</text>
  </view>

  <view class="rh-card form">
    <!-- Phase7 V2: 询价类型 -->
    <view class="form-item">
      <text class="form-label">询价类型</text>
      <picker mode="selector" range="{{typeOptions}}" range-key="label" bindchange="onTypeChange">
        <view class="form-input picker">{{typeOptions[0].label}} ▾</view>
      </picker>
    </view>
    <view class="form-item"><text class="form-label">联系人</text><input class="form-input" placeholder="您的姓名" bindinput="onName" /></view>
    <view class="form-item"><text class="form-label">手机号</text><input class="form-input" placeholder="手机号码" type="number" maxlength="11" bindinput="onPhone" /></view>
    <view class="form-item"><text class="form-label">公司</text><input class="form-input" placeholder="企业名称（选填）" bindinput="onCompany" /></view>
    <view class="form-item"><text class="form-label">数量</text><input class="form-input" placeholder="采购数量" type="number" bindinput="onQuantity" /></view>
    <view class="form-item"><text class="form-label">预算</text><input class="form-input" placeholder="预算范围（选填）" bindinput="onBudget" /></view>
    <!-- Phase7 V2: 使用场景 -->
    <view class="form-item" wx:if="{{inquiryType === 'PURCHASE' || inquiryType === 'LEASE'}}">
      <text class="form-label">使用场景</text>
      <picker mode="selector" range="{{sceneOptions}}" bindchange="onSceneChange">
        <view class="form-input picker">{{procurementScene ? sceneOptions[sceneValues.indexOf(procurementScene)] : '请选择'}} ▾</view>
      </picker>
    </view>
    <!-- Phase7 V2: 采购时间 -->
    <view class="form-item" wx:if="{{inquiryType === 'PURCHASE'}}">
      <text class="form-label">采购时间</text><input class="form-input" placeholder="预计采购时间" bindinput="onPurchaseTime" /></view>
    <view class="form-item full"><text class="form-label">备注</text><textarea class="form-textarea" placeholder="补充说明" bindinput="onRemark" /></view>
    <button class="rh-btn submit" loading="{{submitting}}" bindtap="submit">提交询价</button>
  </view>
</view>