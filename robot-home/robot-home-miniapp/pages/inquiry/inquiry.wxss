.page { padding: 16rpx; }
.robot-name { font-size: 32rpx; font-weight: 600; }
.form { padding: 24rpx; }
.form-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-item.full { flex-direction: column; align-items: flex-start; }
.form-label { width: 140rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.form-input { flex: 1; font-size: 28rpx; }
.form-textarea { width: 100%; min-height: 120rpx; font-size: 28rpx; margin-top: 8rpx; }
.picker { color: #999; }
.submit { margin-top: 32rpx; background: #409eff; color: #fff; border: none; border-radius: 8rpx; font-size: 30rpx; }