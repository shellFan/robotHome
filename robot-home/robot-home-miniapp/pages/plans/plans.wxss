.plans-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.plans-title {
  font-size: 36rpx;
  font-weight: 600;
}
.plans-links {
  display: flex;
  gap: 24rpx;
}
.plans-link {
  font-size: 26rpx;
  color: #1668dc;
}
.plan-card {
  padding: 28rpx;
}
.plan-card--current {
  border: 2rpx solid #1668dc;
}
.plan-card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.plan-card__name {
  font-size: 32rpx;
  font-weight: 600;
}
.plan-card__badge {
  font-size: 22rpx;
  color: #1668dc;
  background: rgba(22, 104, 220, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.plan-card__desc {
  color: #86909c;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.plan-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.plan-card__price {
  font-size: 40rpx;
  font-weight: 700;
  color: #e8590c;
}
.plan-card__duration {
  font-size: 24rpx;
  color: #86909c;
}
.plan-card__ents {
  margin-bottom: 20rpx;
}
.plan-card__ent-label {
  font-size: 24rpx;
  color: #86909c;
}
.plan-card__ent-text {
  font-size: 24rpx;
  color: #4e5969;
  word-break: break-all;
}
.plan-card__actions {
  display: flex;
  justify-content: flex-end;
}
.plan-card__btn {
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
}
.plan-card__unsaleable {
  font-size: 26rpx;
  color: #a9aeb8;
}
.plans-tip {
  padding: 20rpx;
}