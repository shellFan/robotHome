.logo { text-align:center; font-size:40rpx; font-weight:700; color:#1668dc; margin:48rpx 0 32rpx; }
.modes { display:flex; justify-content:space-around; margin-bottom:24rpx; }
.modes text { color:#86909c; padding-bottom:8rpx; }
.modes .on { color:#1668dc; font-weight:600; border-bottom:4rpx solid #1668dc; }
.rh-card input {
  background:#f7f8fa; border-radius:12rpx; height:80rpx; padding:0 24rpx; margin-bottom:20rpx; font-size:28rpx;
}
.sms-row { display:flex; gap:12rpx; align-items:center; margin-bottom:20rpx; }
.sms-row input { flex:1; margin-bottom:0; }
.hint { font-size:24rpx; color:#86909c; margin-bottom:16rpx; line-height:1.5; }
