.toolbar { background:#fff; padding:16rpx 24rpx; }
.search { display:flex; align-items:center; background:#f2f3f5; border-radius:36rpx; padding:0 20rpx; height:68rpx; }
.search input { flex:1; font-size:26rpx; }
.search-btn { color:#1668dc; font-size:26rpx; margin-left:12rpx; }
.toolbar__actions { display:flex; justify-content:space-between; margin-top:12rpx; color:#1668dc; font-size:26rpx; }
.sort-bar { display:flex; gap:12rpx; padding:16rpx 24rpx; background:#fff; border-bottom:1rpx solid #f0f0f0; overflow-x:auto; }
.filter-panel { margin:16rpx 24rpx; }
.filter-label { font-weight:600; margin-bottom:12rpx; }
