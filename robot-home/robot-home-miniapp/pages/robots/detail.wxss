.page { padding-bottom: 120rpx; }
.hero { width: 100%; height: 420rpx; }
.info { padding: 24rpx; }
.name { font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.price { font-size: 40rpx; color: #e4393c; font-weight: 700; margin: 12rpx 0; }
.meta { font-size: 24rpx; margin-top: 8rpx; }
.params { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.param { display: flex; flex-direction: column; align-items: center; background: #f5f7fa; border-radius: 8rpx; padding: 10rpx 20rpx; min-width: 120rpx; }
.param__v { font-size: 28rpx; font-weight: 600; }
.param__k { font-size: 20rpx; color: #999; }
.links { display: flex; flex-wrap: wrap; }
.link { flex: 1; min-width: 45%; padding: 20rpx; font-size: 28rpx; color: #333; border-bottom: 1rpx solid #eee; }
.link:nth-child(odd) { border-right: 1rpx solid #eee; }
.desc { font-size: 26rpx; line-height: 1.7; color: #666; }

/* Bottom Bar */
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; background: #fff; padding: 12rpx 16rpx; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06); z-index: 100; }
.ba { flex: 1; text-align: center; font-size: 24rpx; color: #666; padding: 8rpx 0; }
.inquire { background: #e4393c; color: #fff; border: none; border-radius: 40rpx; font-size: 28rpx; padding: 16rpx 40rpx; line-height: 1.2; }

/* Phase7: Review Summary */
.review-summary { display: flex; align-items: center; gap: 16rpx; margin: 12rpx 0; }
.review-score { font-size: 56rpx; font-weight: 700; color: #ff9900; }
.review-meta { font-size: 24rpx; color: #999; }
.review-dims { display: flex; gap: 16rpx; font-size: 22rpx; color: #666; margin: 8rpx 0; }
.review-link { font-size: 26rpx; color: #409eff; text-align: center; padding: 12rpx 0; }

/* Phase7: Correction Entry */
.correction-entry { font-size: 24rpx; color: #999; text-align: right; padding: 8rpx 0; }

/* Phase7: Similar Robots */
.similar-list { display: flex; flex-direction: column; gap: 16rpx; }
.similar-item { display: flex; gap: 16rpx; padding: 8rpx 0; }
.similar-img { width: 120rpx; height: 90rpx; border-radius: 8rpx; flex-shrink: 0; }
.similar-info { flex: 1; min-width: 0; }
.similar-name { font-size: 28rpx; font-weight: 500; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.similar-price { font-size: 26rpx; color: #e4393c; font-weight: 500; display: block; }
.similar-reason { font-size: 22rpx; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Phase7: Modal Dialog */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 200; }
.modal-dialog { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 201; max-height: 80vh; overflow-y: auto; }
.modal-title { font-size: 32rpx; font-weight: 600; text-align: center; padding: 28rpx 24rpx 12rpx; }
.modal-body { padding: 12rpx 24rpx; }
.modal-footer { display: flex; border-top: 1rpx solid #eee; }
.modal-btn { flex: 1; text-align: center; padding: 24rpx; font-size: 30rpx; }
.modal-btn.cancel { color: #999; }
.modal-btn.confirm { color: #409eff; font-weight: 600; }

/* Form items in modal */
.form-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-label { width: 140rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.form-input { flex: 1; font-size: 28rpx; }
.form-textarea { flex: 1; font-size: 28rpx; min-height: 120rpx; width: 100%; }
.picker { color: #999; }