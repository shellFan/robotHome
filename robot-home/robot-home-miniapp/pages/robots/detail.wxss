.hero { width:100%; height:420rpx; background:#f2f3f5; }
.info { margin: -40rpx 24rpx 16rpx; position:relative; }
.name { font-size:36rpx; font-weight:600; margin-bottom:8rpx; }
.price { color:#1668dc; font-size:36rpx; font-weight:700; margin:12rpx 0; }
.meta { margin-bottom:16rpx; }
.params { display:flex; flex-wrap:wrap; border-top:1rpx solid #f0f0f0; padding-top:16rpx; }
.param { width:33.33%; text-align:center; margin-bottom:12rpx; }
.param__v { display:block; font-weight:600; font-size:26rpx; }
.param__k { font-size:22rpx; color:#86909c; }
.links { margin:0 24rpx 16rpx; padding:0; }
.link { padding:28rpx 24rpx; border-bottom:1rpx solid #f0f0f0; font-size:28rpx; }
.link:last-child { border-bottom:none; }
.desc { font-size:26rpx; color:#4e5969; line-height:1.7; white-space:pre-wrap; }
.bottom-bar {
  position:fixed; left:0; right:0; bottom:0; background:#fff; display:flex; align-items:center;
  padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #f0f0f0; gap:8rpx;
}
.ba { flex:1; text-align:center; font-size:24rpx; color:#4e5969; }
.inquire { flex:1.4; margin:0; height:72rpx; line-height:72rpx; }
.page { padding-bottom:140rpx; }
