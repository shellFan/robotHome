.circles { white-space:nowrap; background:#fff; padding:16rpx 24rpx; }
.circles .chip { display:inline-block; margin-right:12rpx; }
.post__user { display:flex; gap:16rpx; align-items:center; margin-bottom:12rpx; }
.post__user image { width:64rpx; height:64rpx; border-radius:50%; background:#f2f3f5; }
.name { font-weight:600; font-size:26rpx; }
.post__title { font-size:30rpx; font-weight:600; margin-bottom:8rpx; }
.post__content { color:#4e5969; font-size:26rpx; margin-bottom:12rpx; }
.post__cover { width:100%; height:280rpx; border-radius:12rpx; background:#f2f3f5; }
.post__meta { margin-top:12rpx; }
.fab {
  position:fixed; right:32rpx; bottom:calc(120rpx + env(safe-area-inset-bottom));
  width:100rpx; height:100rpx; border-radius:50%; background:#1668dc; color:#fff;
  display:flex; align-items:center; justify-content:center; font-size:28rpx;
  box-shadow:0 8rpx 24rpx rgba(22,104,220,.35);
}
