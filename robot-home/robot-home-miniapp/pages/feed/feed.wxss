.feed-page {
  padding: 16rpx;
  min-height: 100vh;
  background: #f5f6f8;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feed-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 20rpx;
  gap: 20rpx;
}

.feed-item__cover {
  width: 160rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.feed-item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.feed-item__type {
  font-size: 22rpx;
  color: #1668dc;
  background: #e8f0fe;
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  width: fit-content;
  margin-bottom: 8rpx;
}

.feed-item__title {
  font-size: 28rpx;
  color: #303133;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-item__meta {
  font-size: 22rpx;
  color: #909399;
  margin-top: 8rpx;
}

.feed-empty,
.feed-loading,
.feed-finished {
  text-align: center;
  padding: 40rpx 0;
  color: #909399;
  font-size: 26rpx;
}