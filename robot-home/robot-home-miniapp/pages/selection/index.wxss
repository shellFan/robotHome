.search-bar { display:flex; align-items:center; padding:16rpx 24rpx; background:#fff; gap:16rpx; }
.search-bar__input { flex:1; background:#f2f3f5; border-radius:32rpx; height:64rpx; padding:0 24rpx; font-size:26rpx; }
.search-bar__filter { font-size:26rpx; color:#1668dc; white-space:nowrap; }
.filter-panel { background:#fff; padding:24rpx; border-bottom:1rpx solid #f0f0f0; }
.filter-item { display:flex; align-items:center; margin-bottom:20rpx; }
.filter-label { width:140rpx; font-size:26rpx; color:#4e5969; flex-shrink:0; }
.filter-value { font-size:26rpx; color:#1f2329; }
.filter-budget { display:flex; align-items:center; gap:12rpx; font-size:26rpx; }
.filter-input { width:120rpx; height:56rpx; background:#f2f3f5; border-radius:8rpx; padding:0 12rpx; font-size:26rpx; }
.filter-actions { display:flex; gap:16rpx; justify-content:flex-end; margin-top:12rpx; }
.result__header { display:flex; gap:20rpx; align-items:center; }
.result__cover { width:160rpx; height:120rpx; border-radius:12rpx; background:#f2f3f5; flex-shrink:0; }
.result__body { flex:1; min-width:0; }
.result__name { font-size:28rpx; font-weight:600; margin-bottom:8rpx; }
.result__meta { display:flex; gap:8rpx; flex-wrap:wrap; margin-bottom:8rpx; }
.result__price { color:#1668dc; font-size:26rpx; font-weight:600; }
.result__score { text-align:center; flex-shrink:0; }
.score-num { font-size:36rpx; font-weight:700; color:#00b42a; }
.score-label { font-size:20rpx; color:#86909c; }
.result__params { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:16rpx; padding-top:16rpx; border-top:1rpx solid #f0f0f0; }
.param { font-size:24rpx; color:#4e5969; }
.param-label { color:#86909c; }
.param-value { margin-left:4rpx; font-weight:500; }
.result__actions { display:flex; gap:16rpx; margin-top:16rpx; justify-content:flex-end; }