.toolbar { display:flex; align-items:center; background:#fff; padding:16rpx 24rpx; gap:16rpx; }
.toolbar input { flex:1; background:#f2f3f5; border-radius:32rpx; height:64rpx; padding:0 24rpx; font-size:26rpx; }
.toolbar text { color:#1668dc; }
.row { display:flex; align-items:center; gap:20rpx; padding:20rpx; }
.row image { width:96rpx; height:96rpx; border-radius:12rpx; background:#f2f3f5; }
.name { font-weight:600; margin-bottom:6rpx; }
.body { flex:1; min-width:0; }
