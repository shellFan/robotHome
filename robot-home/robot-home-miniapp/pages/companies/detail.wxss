.head{display:flex;align-items:center;gap:20rpx;padding:24rpx}
.head image{width:96rpx;height:96rpx;border-radius:12rpx;flex-shrink:0}
.head .name{font-size:32rpx;font-weight:600;margin-bottom:4rpx}
.head .rh-text-light{font-size:24rpx}
.follow-btn{margin-left:auto;font-size:24rpx;padding:8rpx 24rpx;border-radius:24rpx;background:#1668dc;color:#fff;flex-shrink:0}
.follow-btn.followed{background:#f5f5f5;color:#999}
.rh-section-title{font-size:28rpx;font-weight:600;padding:0 0 8rpx}
.brand-chip{display:inline-flex;flex-direction:column;align-items:center;width:120rpx;background:#fff;border-radius:12rpx;padding:16rpx 8rpx}
.brand-chip__logo{width:64rpx;height:64rpx;margin-bottom:8rpx}
.brand-chip__name{font-size:22rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:108rpx}
.robot-row{display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f5f5f5}
.robot-row__cover{width:100rpx;height:100rpx;border-radius:8rpx;margin-right:16rpx;flex-shrink:0}
.robot-row__body{flex:1;min-width:0}
.robot-row__name{font-size:26rpx;margin-bottom:4rpx}
.robot-row__price{font-size:22rpx;color:#e4393c}
.article-row{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0;border-bottom:1rpx solid #f5f5f5}
.article-row:last-child{border-bottom:none}
.article-row__title{flex:1;font-size:26rpx;margin-right:16rpx}
.rh-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}