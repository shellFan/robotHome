.question__header { display:flex; gap:16rpx; align-items:center; margin-bottom:12rpx; }
.question__avatar { width:56rpx; height:56rpx; border-radius:50%; background:#f2f3f5; flex-shrink:0; }
.question__user { flex:1; min-width:0; }
.question__user .name { font-weight:600; font-size:26rpx; }
.question__status { font-size:22rpx; padding:4rpx 12rpx; border-radius:8rpx; flex-shrink:0; }
.status--accepted { background:#e8f8e8; color:#00b42a; }
.status--answered { background:#e8f3ff; color:#1668dc; }
.status--pending { background:#fff7e8; color:#ff7d00; }
.question__title { font-size:30rpx; font-weight:600; margin-bottom:8rpx; line-height:1.5; }
.question__content { color:#4e5969; font-size:26rpx; margin-bottom:8rpx; }
.question__robot { margin-bottom:8rpx; }
.question__meta { margin-top:8rpx; }
.ask-overlay { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.5); z-index:100; display:flex; align-items:center; justify-content:center; }
.ask-dialog { background:#fff; border-radius:16rpx; padding:32rpx; width:80%; max-width:600rpx; }
.ask-dialog__title { font-size:32rpx; font-weight:600; margin-bottom:24rpx; }
.ask-dialog__input { border:1rpx solid #e5e6eb; border-radius:8rpx; height:72rpx; padding:0 16rpx; margin-bottom:16rpx; font-size:28rpx; }
.ask-dialog__textarea { border:1rpx solid #e5e6eb; border-radius:8rpx; height:160rpx; padding:16rpx; margin-bottom:24rpx; font-size:28rpx; width:100%; box-sizing:border-box; }
.ask-dialog__actions { display:flex; gap:16rpx; justify-content:flex-end; }