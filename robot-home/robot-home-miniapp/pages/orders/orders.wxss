.orders-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}
.orders-tab {
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #4e5969;
  background: #fff;
}
.orders-tab--active {
  background: #1668dc;
  color: #fff;
}
.orders-empty-btn {
  margin-top: 20rpx;
}
.order-card {
  padding: 24rpx;
}
.order-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.order-card__no {
  font-size: 26rpx;
  color: #4e5969;
}
.order-card__status {
  font-size: 26rpx;
  font-weight: 600;
}
.order-card__status--PENDING_PAYMENT { color: #e8590c; }
.order-card__status--PAID { color: #00b42a; }
.order-card__status--CANCELLED { color: #86909c; }
.order-card__status--REFUNDED { color: #f53f3f; }
.order-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.order-card__amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #e8590c;
}
.order-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}
.order-card__btn {
  font-size: 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
}
.orders-tip {
  padding: 20rpx;
}