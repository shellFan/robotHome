.player { width:100%; height:420rpx; background:#000; border-radius:12rpx; }
.player-fallback { position:relative; width:100%; height:420rpx; overflow:hidden; border-radius:12rpx; background:#111; }
.player-fallback__cover { position:absolute; inset:0; width:100%; height:100%; opacity:.45; }
.player-fallback__content { position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20rpx; width:100%; height:100%; padding:32rpx; box-sizing:border-box; color:#fff; text-align:center; font-size:26rpx; }
.player-fallback__copy { min-width:240rpx; margin:0; }
.title { font-size:32rpx; font-weight:600; margin:20rpx 0 8rpx; }
.desc { margin-top:16rpx; color:#4e5969; line-height:1.6; font-size:26rpx; }
.actions { display:flex; gap:16rpx; margin-top:24rpx; }
