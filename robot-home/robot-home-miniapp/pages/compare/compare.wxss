.actions { display:flex; gap:16rpx; margin-bottom:16rpx; }
.cmp-scroll { white-space:nowrap; }
.cmp-col {
  display:inline-block; width:280rpx; background:#fff; border-radius:16rpx; padding:16rpx;
  margin-right:16rpx; vertical-align:top; white-space:normal;
}
.cmp-col image { width:100%; height:180rpx; border-radius:12rpx; background:#f2f3f5; }
.name { font-weight:600; margin:8rpx 0; font-size:26rpx; }
.price { color:#1668dc; font-weight:600; margin-bottom:12rpx; }
.param { padding:8rpx 0; border-top:1rpx solid #f5f5f5; font-size:22rpx; }
.k { display:block; color:#86909c; }
.v { display:block; }
