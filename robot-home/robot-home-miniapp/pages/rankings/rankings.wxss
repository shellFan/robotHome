.types,.times{display:flex;white-space:nowrap;padding:16rpx 24rpx;border-bottom:1rpx solid #f0f0f0}
.chip{display:inline-block;padding:8rpx 24rpx;margin-right:16rpx;font-size:24rpx;border-radius:24rpx;background:#f5f5f5;color:#666}
.chip--on{background:#1668dc;color:#fff}
.rh-container{padding:16rpx 24rpx}
.robot-row{display:flex;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #f5f5f5}
.robot-row__cover{width:120rpx;height:120rpx;border-radius:12rpx;margin:0 20rpx;flex-shrink:0}
.robot-row__body{flex:1;min-width:0}
.robot-row__name{font-size:28rpx;font-weight:600;color:#333;margin-bottom:8rpx}
.robot-row__price{font-size:24rpx;color:#999}
.rank{width:56rpx;text-align:center;font-size:32rpx;font-weight:700;color:#999;flex-shrink:0}
.rank--top{color:#1668dc;font-size:36rpx}
.badge{font-size:20rpx;padding:4rpx 12rpx;border-radius:8rpx;margin-left:12rpx;flex-shrink:0}
.badge--gold{background:#fff3e0;color:#e6a23c}
.badge--silver{background:#f0f0f0;color:#909399}
.badge--bronze{background:#fdf2ec;color:#e6a23c}
.rh-empty{text-align:center;padding:80rpx 0;color:#999;font-size:28rpx}
.rh-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}