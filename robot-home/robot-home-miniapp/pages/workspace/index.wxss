.page { padding: 24rpx; }
.loading { text-align: center; color: #999; padding: 60rpx 0; }

.empty { text-align: center; padding: 80rpx 40rpx; }
.empty-title { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.empty-desc { font-size: 28rpx; color: #999; }

.company-header { display: flex; align-items: center; padding: 24rpx; margin-bottom: 24rpx; }
.company-header .logo { width: 100rpx; height: 100rpx; border-radius: 12rpx; margin-right: 24rpx; background: #f5f5f5; }
.company-header .info { flex: 1; }
.company-header .name { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.company-header .meta { display: flex; align-items: center; gap: 16rpx; }
.company-header .role { font-size: 24rpx; color: #666; background: #f0f0f0; padding: 4rpx 16rpx; border-radius: 8rpx; }
.verify-badge { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 8rpx; color: #999; background: #f5f5f5; }
.verify-badge.verified { color: #fff; background: #07c160; }

.quick-links { display: flex; padding: 24rpx 0; margin-bottom: 24rpx; }
.quick-links .link { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 26rpx; color: #333; }
.quick-links .link-icon { font-size: 48rpx; }

.section-title { font-size: 30rpx; font-weight: bold; color: #333; margin: 24rpx 0 16rpx; }

.claim-item, .change-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx; color: #333; }
.claim-item:last-child, .change-item:last-child { border-bottom: none; }

.status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.status.PENDING { color: #fa8c16; background: #fff7e6; }
.status.APPROVED { color: #07c160; background: #e6ffed; }
.status.REJECTED { color: #f5222d; background: #fff1f0; }
.status.CANCELLED { color: #999; background: #f5f5f5; }