<view class="page">
  <view class="bar">
    <input focus placeholder="搜索机器人、品牌、资讯" value="{{keyword}}" bindinput="onInput" bindconfirm="doSearch" confirm-type="search" />
    <text bindtap="doSearch">搜索</text>
  </view>
  <view class="rh-container" wx:if="{{suggest.length}}">
    <view class="sug" wx:for="{{suggest}}" wx:key="*this" data-kw="{{item.keyword || item}}" bindtap="doSearch">{{item.keyword || item}}</view>
  </view>
  <view class="rh-container" wx:else>
    <view class="rh-section-head" wx:if="{{history.length}}">
      <text class="rh-section-title">历史搜索</text>
      <text class="rh-more" bindtap="clearHistory">清空</text>
    </view>
    <view class="chips" wx:if="{{history.length}}">
      <text class="chip" wx:for="{{history}}" wx:key="*this" data-kw="{{item.keyword || item}}" bindtap="doSearch">{{item.keyword || item}}</text>
    </view>
    <view class="rh-section-head" style="margin-top:24rpx">
      <text class="rh-section-title">热门搜索</text>
    </view>
    <view class="chips">
      <text class="chip" wx:for="{{hot}}" wx:key="*this" data-kw="{{item.keyword || item}}" bindtap="doSearch">{{item.keyword || item}}</text>
    </view>
  </view>
</view>