.toolbar { display:flex; align-items:center; background:#fff; padding:16rpx 24rpx; gap:16rpx; }
.toolbar input { flex:1; background:#f2f3f5; border-radius:32rpx; height:64rpx; padding:0 24rpx; font-size:26rpx; }
.toolbar text { color:#1668dc; }
.grid { display:flex; flex-wrap:wrap; gap:16rpx; }
.item { width:calc(25% - 12rpx); background:#fff; border-radius:12rpx; padding:16rpx 8rpx; text-align:center; }
.item image { width:80rpx; height:80rpx; }
.item text { display:block; font-size:22rpx; margin-top:8rpx; }
