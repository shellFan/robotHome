.filter-bar { display:flex; gap:16rpx; padding:16rpx 24rpx; background:#fff; }
.filter-chip { padding:10rpx 20rpx; background:#f2f3f5; border-radius:32rpx; font-size:24rpx; color:#4e5969; }
.inquiry__header { display:flex; justify-content:space-between; align-items:center; margin-bottom:12rpx; }
.inquiry__status { font-size:24rpx; color:#1668dc; }
.inquiry__title { font-size:30rpx; font-weight:600; margin-bottom:8rpx; }
.inquiry__info { font-size:24rpx; margin-bottom:4rpx; }
.inquiry__footer { margin-top:12rpx; padding-top:12rpx; border-top:1rpx solid #f0f0f0; }