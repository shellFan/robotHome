# 机器人之家 Phase15 Night4 排练环境变量示例
# ⚠️ 仅用于隔离排练，禁止用于生产
# 使用方式: cp .env.rehearsal.example .env.rehearsal

# 排练MySQL（Fresh路径：空库→Flyway全量迁移）
REHEARSAL_MYSQL_HOST=mysql-rehearsal
REHEARSAL_MYSQL_PORT=3306
REHEARSAL_MYSQL_DB=robot_home_rehearsal
REHEARSAL_MYSQL_USER=root
REHEARSAL_MYSQL_PASSWORD=rehearsal_root_pw

# 排练MySQL（Upgrade路径：Phase14历史库→Flyway增量迁移）
REHEARSAL_UPGRADE_MYSQL_HOST=mysql-rehearsal-upgrade
REHEARSAL_UPGRADE_MYSQL_PORT=3306
REHEARSAL_UPGRADE_MYSQL_DB=robot_home_upgrade
REHEARSAL_UPGRADE_MYSQL_USER=root
REHEARSAL_UPGRADE_MYSQL_PASSWORD=rehearsal_upgrade_pw

# 排练Redis
REHEARSAL_REDIS_HOST=redis-rehearsal
REHEARSAL_REDIS_PORT=6379

# 排练MinIO
REHEARSAL_MINIO_ENDPOINT=http://minio-rehearsal:9000
REHEARSAL_MINIO_ACCESS_KEY=rehearsal_minio
REHEARSAL_MINIO_SECRET_KEY=rehearsal_minio_pw
REHEARSAL_MINIO_BUCKET=robot-home-rehearsal

# 排练Nginx
REHEARSAL_NGINX_PORT=18080

# Server连接配置（供Spring Boot容器使用，Docker可用时）
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-rehearsal:3306/robot_home_rehearsal?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rehearsal_root_pw
SPRING_REDIS_HOST=redis-rehearsal
SPRING_REDIS_PORT=6379