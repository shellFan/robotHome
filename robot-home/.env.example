# ============================================================
# 机器人之家 生产环境配置模板
# 使用：复制为 .env 并填写实际值
# ⚠️ 切勿将 .env 文件提交到版本控制！
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=           # 必填：MySQL root 密码（强密码，仅运维使用）
MYSQL_APP_USERNAME=             # 必填：MySQL 业务账号（后端+采集器使用此账号连接）
MYSQL_APP_PASSWORD=             # 必填：MySQL 业务账号密码（强密码，与 root 密码不同）
MYSQL_DATABASE=robot_home       # 数据库名（默认 robot_home）
# MYSQL_PORT=3306               # MySQL 端口（默认不暴露，调试时取消注释并绑定 127.0.0.1）

# --- Redis ---
REDIS_PASSWORD=                 # 必填：Redis 密码（强密码）
# REDIS_PORT=6379               # Redis 端口（默认不暴露，调试时取消注释并绑定 127.0.0.1）

# --- MinIO ---
MINIO_ACCESS_KEY=               # 必填：MinIO 访问密钥
MINIO_SECRET_KEY=               # 必填：MinIO 密钥（强密码）
MINIO_BUCKET=robot-home         # MinIO 桶名
# MINIO_PORT=9000               # MinIO API 端口（默认不暴露）
# MINIO_CONSOLE_PORT=9001       # MinIO 控制台端口（默认不暴露）

# --- 后端 ---
JWT_SECRET=                     # 必填：JWT 签名密钥（至少32字符，禁止示例值/空值/弱密钥）
ADMIN_INIT_USERNAME=admin       # 管理员用户名
ADMIN_INIT_PASSWORD=            # 必填：管理员初始密码（强密码，与 MySQL 密码不同）
BACKEND_PORT=8081               # 后端端口
FILE_STORAGE_TYPE=minio         # 文件存储类型：local / minio

# --- 采集器 ---
CRAWLER_API_KEY=                # 必填：采集器 API Key（强随机字符串，至少32字符）
CRAWLER_DEV_MODE=false          # 开发模式（生产必须 false）
COLLECTOR_PORT=8082             # 采集器端口

# --- Nginx ---
NGINX_PORT=80                   # Nginx 端口